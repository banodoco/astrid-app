#!/usr/bin/env bash
# Fast pre-push safety checks. Full Vitest, Playwright, build, type, and
# journey coverage remains in CI; this command checks only changed files.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
# Tests may launch this script with a disposable repository in Git's local
# environment variables. Let the child checks use their own working tree.
while IFS= read -r git_local_env_var; do unset "$git_local_env_var"; done < <(git rev-parse --local-env-vars)
usage() { echo "usage: $0 [remote-name remote-url] < local-ref local-sha remote-ref remote-sha" >&2; }

changed_files() {
  if [ "$#" -eq 2 ]; then
    while read -r _local_ref local_sha _remote_ref remote_sha; do
      [ -n "${local_sha:-}" ] || continue
      if [[ "$remote_sha" =~ ^0+$ ]]; then git diff-tree --root --no-commit-id --name-only -r "$local_sha"
      else git diff --name-only "$remote_sha" "$local_sha"; fi
    done
    return
  fi
  if git rev-parse --verify --quiet origin/main >/dev/null; then git diff --name-only origin/main...HEAD; fi
  git diff --name-only HEAD
  git ls-files --others --exclude-standard
}
find_tool() { local name=$1; if [ -x "node_modules/.bin/$name" ]; then printf '%s\n' "node_modules/.bin/$name"; else command -v "$name" || true; fi; }

run_changed_checks() {
  mapfile -t changed < <(changed_files "$@" | sed '/^$/d' | sort -u)
  if [ "${#changed[@]}" -eq 0 ]; then echo "pre-push: no changed files; full suites remain in CI"; return 0; fi
  mapfile -t format_files < <(printf '%s\n' "${changed[@]}" | awk '/\.(cjs|css|js|json|jsx|md|mjs|ts|tsx|yaml|yml)$/')
  if [ "${#format_files[@]}" -gt 0 ]; then
    prettier_bin=$(find_tool prettier)
    [ -n "$prettier_bin" ] || { echo "pre-push: changed web/config files require Prettier for syntax/format checks" >&2; return 2; }
    "$prettier_bin" --check --ignore-unknown "${format_files[@]}"
  fi
  mapfile -t node_files < <(printf '%s\n' "${changed[@]}" | awk '/\.(cjs|js|mjs)$/')
  if [ "${#node_files[@]}" -gt 0 ]; then
    node_bin=${NODE_BIN:-}; [ -n "$node_bin" ] || node_bin=$(command -v node || true)
    [ -n "$node_bin" ] || { echo "pre-push: changed JavaScript files require Node for syntax checks" >&2; return 2; }
    for file in "${node_files[@]}"; do [ -f "$file" ] && "$node_bin" --check "$file"; done
  fi
  if printf '%s\n' "${changed[@]}" | grep -Eq '^(src/integrations/runtime/|src/tools/video-editor/(.*/)?renderRouter\.ts$|(.*/)?useTimelineSave\.ts$|(.*/)?usePollSync\.ts$|config/vite/paired|scripts/dev-local-workspace|scripts/runtime-discovery-proxy|tests/e2e/local/)'; then
    echo "pre-push: runtime-facing paths changed; thin journeys are deferred to CI" >&2
  fi
  echo "pre-push: checked ${#changed[@]} changed file(s); full suites remain in CI"
}

case "${1:-}" in
  -h|--help) usage ;;
  "") run_changed_checks ;;
  *) [ "$#" -eq 2 ] || { usage; exit 2; }; run_changed_checks "$@" ;;
esac

    ],
    "replies": [
      {
        "kind": "accepted",
        "runtime_wire": "accepted",
        "expected": "canonical trim and id_map applied; queue drains; dependent uses accepted head"
      },
      {
        "kind": "merged",
        "runtime_wire": "rebased",
        "expected": "Agent field survives; Runtime returns canonical head/id_map; dependent is revalidated against that head"
      },
      {
        "kind": "refused",
        "runtime_wire": "refused/conflict",
        "expected": "canonical head remains authoritative; predecessor is surfaced; dependent is revalidated or rolled back with a message"
      }
    ],
    "required_seams": [
      "App split capture/submit port for clip.split and created-id binding",
      "App mixed-command queue acceptance of clip.trim against a newly created id",
      "Runtime reply payload distinguishing merged/rebased from accepted and returning canonical id_map",
      "A2 dependent revalidation or rollback after predecessor refusal",

#!/bin/sh
# Astrid's bootstrap. Install policy and recovery live in astrid.installer.
set -eu
umask 077
UV_VERSION=0.11.32
PYTHON_VERSION=3.11.13
case "$(uname -s)" in
    Darwin) data_home="$HOME/.local/share"; log="$HOME/Library/Logs/Astrid Runtime/install.log" ;;
    Linux) data_home=${XDG_DATA_HOME:-$HOME/.local/share}; log="${XDG_STATE_HOME:-$HOME/.local/state}/astrid-runtime/logs/install.log" ;;
    *) echo 'Astrid installs on Windows from PowerShell. Open PowerShell and run: irm https://astrid.haus/install.ps1 | iex' >&2; exit 1 ;; esac
bootstrap="$data_home/astrid/bootstrap"
mkdir -p "$bootstrap" "$(dirname "$log")"
chmod 700 "$(dirname "$log")"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/astrid-install.XXXXXXXX")
spin_pid=
# Stop the readiness line's tracks (below) before anything else is printed.
spin_stop() {
    if [ -n "$spin_pid" ]; then
        kill "$spin_pid" 2>/dev/null || :
        wait "$spin_pid" 2>/dev/null || :
        spin_pid=
    fi
}
trap 'spin_stop; rm -rf "$tmp"' EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM
# Let the foreground installer finish its rollback after the first Ctrl+C.
trap ':' INT
fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --show-error --location "$1" --output "$2"
    else
        wget -q "$1" -O "$2"
    fi
}
# What failed, in one plain line, then where the full story is.
fail() { spin_stop; echo "Astrid couldn't finish. Your work is kept." >&2; echo "$1" >&2; echo "Details: $log" >&2; exit 1; }
download_failed="It couldn't download what it needs. Check your internet connection, then run the same command again."
prepare_failed="It couldn't prepare Python on this computer. Check that the disk has free space, then run the same command again."
manifest="$tmp/manifest.json"
manifest_next=0
manifest_provided=0
for arg in "$@"; do
    if [ "$manifest_next" -eq 1 ]; then
        manifest=$arg
        manifest_provided=1
        manifest_next=0
        continue
    fi
    case "$arg" in
        --manifest) manifest_next=1; manifest_provided=1 ;;
        --manifest=*) manifest=${arg#--manifest=}; manifest_provided=1 ;;
    esac
done
if [ "$manifest_next" -eq 1 ] || [ -z "$manifest" ]; then
    echo 'A path is required after --manifest.' >&2
    exit 2
fi
# Only a computer without an earlier install (its version pointer or the
# per-user selection record) hears that the first time is slow.
ready='Getting Astrid ready.'
if [ ! -e "$data_home/astrid/current" ] && [ ! -e "$data_home/astrid-install.json" ]; then
    ready="$ready The first time takes a few minutes."
fi
# A calm sign of life on an interactive terminal: mink tracks in snow run
# along the end of the line until the installer starts talking, which leaves a
# check mark. Pipes, files, CI, NO_COLOR and TERM=dumb get the plain line.
# The tracks run only while the whole line fits the terminal's width (a wrapped
# line cannot be redrawn in place); otherwise the line just gets its mark.
# astrid.installer.progress draws the same frames from the same rule, and
# draws them only when told so here.
# The terminal's width now, in $cols; empty when nothing can tell.
spin_columns() {
    cols=$(stty size </dev/tty 2>/dev/null) || cols=
    cols=${cols#* }
    case $cols in ''|*[!0-9]*) cols=${COLUMNS:-} ;; esac
    case $cols in ''|*[!0-9]*) cols= ;; esac
}
# Whether the line, its tracks and room for an echoed ^C fit on one row.
spin_fits() {
    spin_columns
    [ -n "$cols" ] && [ $((${#ready} + 1 + spin_width + 2)) -lt "$cols" ]
}
spin_style=
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ -z "${CI:-}" ] && [ "${TERM:-}" != dumb ] && sleep 0.01 2>/dev/null; then
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) spin_style=unicode spin_mark='✓' spin_slots=6 spin_period=8 spin_blank=' ' spin_pad=12 ;;
        *) spin_style=ascii spin_mark='done' spin_slots=4 spin_period=5 spin_blank='  ' spin_pad=9 ;;
    esac
    spin_width=$((spin_slots * (${#spin_blank} + 1) - 1))
    spin_columns
    # The width is a fallback for the installer, which reads it live from its stdin.
    export ASTRID_INSTALL_PROGRESS="$spin_style:$cols"
else
    unset ASTRID_INSTALL_PROGRESS
fi
# Minks run one after another across $spin_slots bound slots. A run that sets
# off at tick s lays a print in slot i at tick s+i; the print then ages one
# stage a tick through the arguments (freshest first) and is gone. A new run
# sets off every $spin_period ticks, so the stream never resets. One tick is
# 0.19 s, until the installer starts or spin_stop interrupts it.
spin() {
    tick=0
    trap 'spin_end ""' TERM
    while :; do
        sleep 0.19
        kill -0 "$$" 2>/dev/null || exit 0  # never outlive the script
        if [ -e "$tmp/installer-started" ]; then spin_end "$spin_mark"; fi
        if [ "$spin_still" -eq 1 ]; then continue; fi
        if ! spin_fits; then
            # The terminal was narrowed: erase the tracks and end the line plainly.
            spin_repeat "$spin_width" '\b'
            spin_repeat "$spin_width" ' '
            spin_repeat "$spin_width" '\b'
            spin_still=1
            continue
        fi
        frame='' slot=0
        while [ "$slot" -lt "$spin_slots" ]; do
            age=$(( (tick - slot + spin_slots * spin_period) % spin_period ))
            if [ "$age" -lt $# ]; then eval "cell=\${$((age + 1))}"; else cell=$spin_blank; fi
            if [ "$slot" -eq 0 ]; then frame=$cell; else frame="$frame $cell"; fi
            slot=$((slot + 1))
        done
        spin_repeat "$spin_width" '\b'
        printf '%s' "$frame"
        tick=$(( (tick + 1) % spin_period ))
    done
}
# Print $2 (a space, or the escape \b) $1 times.
spin_repeat() {
    cells=0
    while [ "$cells" -lt "$1" ]; do printf '%b' "$2"; cells=$((cells + 1)); done
}
# End the line with $1 (the mark, or nothing) in place of the tracks. Rewriting
# a line with tracks from its start also clears a ^C the terminal echoed.
spin_end() {
    if [ "$spin_still" -eq 1 ]; then
        printf '%s\n' "$1"
    else
        printf '\r%s %s' "$ready" "$1"
        if [ -n "$1" ]; then spin_repeat "$spin_pad" ' '; else spin_repeat $((spin_width + 2)) ' '; fi
        printf '\n'
    fi
    : >"$tmp/spin-done"
    exit 0
}
if [ -n "$spin_style" ]; then
    printf '%s ' "$ready"
    if spin_fits; then spin_still=0; spin_repeat "$spin_width" ' '; else spin_still=1; fi
    if [ "$spin_style" = unicode ]; then spin ⠳ ⠲ ⠢ ⠠ & else spin "'." "' " " ." & fi
    spin_pid=$!
else
    echo "$ready"
fi
if [ "$manifest_provided" -ne 1 ]; then
    manifest_url=${ASTRID_INSTALL_MANIFEST_URL:-https://astrid.haus/install-manifest.json}
    fetch "$manifest_url" "$manifest" 2>>"$log" || fail "$download_failed"
fi
uv="$bootstrap/uv"
uv_matches=0
if [ -x "$uv" ]; then
    uv_found=$("$uv" --version 2>>"$log") || uv_found=
    case "$uv_found" in
        "uv $UV_VERSION"|"uv $UV_VERSION "*) uv_matches=1 ;;
    esac
fi
if [ "$uv_matches" -ne 1 ]; then
    fetch "https://astral.sh/uv/$UV_VERSION/install.sh" "$tmp/uv.sh" 2>>"$log" || fail "$download_failed"
    UV_UNMANAGED_INSTALL="$bootstrap" UV_NO_MODIFY_PATH=1 sh "$tmp/uv.sh" >>"$log" 2>&1 || fail "$download_failed"
fi
export UV_PYTHON_INSTALL_DIR="$bootstrap/python"
export ASTRID_INSTALL_UV="$uv"
"$uv" python install "$PYTHON_VERSION" --no-bin >>"$log" 2>&1 || fail "$prepare_failed"
# With curl | sh, uv would inherit the script pipe and forward a second
# SIGINT after the terminal already delivered one. Keep interactive stdin.
if (: </dev/tty) 2>/dev/null; then exec 3</dev/tty; else exec 3</dev/null; fi
# Keep stdout live and retain its status independently of the progress reader.
mkfifo "$tmp/progress"
# With the tracks running, hold the installer's first byte until its line is
# finished, so the two never draw over each other.
relay() {
    first=$(dd bs=1 count=1 2>/dev/null; echo .)
    first=${first%.}
    if [ -n "$first" ]; then
        : >"$tmp/installer-started"
        waited=0
        while [ ! -e "$tmp/spin-done" ] && [ "$waited" -lt 40 ]; do sleep 0.05; waited=$((waited + 1)); done
        printf '%s' "$first"
        printf '%s' "$first" >"$tmp/core.out"
    fi
    exec tee -i -a "$tmp/core.out"
}
if [ -n "$spin_pid" ]; then relay <"$tmp/progress" & else tee -i "$tmp/core.out" <"$tmp/progress" & fi
progress_pid=$!
# This only resolves manifest pins and hands off; the package owns every step.
if "$uv" run --no-project --python "$PYTHON_VERSION" python -u -I -c '
import json, os, re, subprocess, sys
from pathlib import Path
from urllib.parse import urlsplit
from urllib.request import url2pathname
venv, manifest, *flags = sys.argv[1:]
with open(manifest, encoding="utf-8") as stream: pins = json.load(stream)
if pins["tools"]["uv"]["version"] != "0.11.32" or pins["tools"]["python"]["version"] != "3.11.13":
    raise SystemExit("The bootstrap and manifest tool pins disagree.")
def git_requirement(name):
    pin = pins[name]
    sha = pin["sha"]
    if not isinstance(sha, str) or not re.fullmatch("[0-9a-f]{40}", sha):
        raise SystemExit("Invalid source pin")
    if "repo" not in pin:
        return "https://github.com/banodoco/astrid-" + name + "/archive/" + sha + ".tar.gz"
    repo = pin["repo"]
    if not isinstance(repo, str) or not repo:
        raise SystemExit("Source repo must be an absolute local path or file:// URL")
    if repo.startswith("file://"):
        parsed = urlsplit(repo)
        if parsed.netloc not in ("", "localhost") or parsed.query or parsed.fragment:
            raise SystemExit("Invalid local source URL")
        repo = url2pathname(parsed.path)
    path = Path(repo)
    if not path.is_absolute(): raise SystemExit("Source repo must be absolute")
    # uv reads the committed Git tree, never the mutable checkout.
    return "git+" + path.as_uri() + "@" + sha
uv = os.environ["ASTRID_INSTALL_UV"]
agent_requirement = git_requirement("agent")
# Each run builds its environment in its own temporary directory, which the
# shell removes on exit, never beside a supplied manifest that may be reused.
venv = Path(venv)
subprocess.run([uv, "venv", str(venv), "--python", pins["tools"]["python"]["version"]], check=True)
python = venv / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
runtime = git_requirement("runtime")
client = runtime + "#subdirectory=packages/python"
subprocess.run([uv, "pip", "install", "--python", str(python), "--no-deps", runtime, client, agent_requirement], check=True)
has_manifest = any(flag == "--manifest" or flag.startswith("--manifest=") for flag in flags)
args = [uv, "run", "--no-project", "--python", str(python), "python", "-u", "-I", "-m", "astrid", "install"]
if not has_manifest: args.extend(["--manifest", manifest])
args.extend(flags)
os.execv(args[0], args)
' "$tmp/bootstrap-venv" "$manifest" "$@" <&3 >"$tmp/progress" 2>>"$log"; then status=0; else status=$?; fi
wait "$progress_pid"
spin_stop
if [ "$status" -ne 0 ]; then
    # The installer's own failure paragraph, or its run receipt (which ends with a
    # Details line), already said what happened; only a silent exit gets this one.
    if ! grep -Fq "Astrid couldn't finish. Your work is kept." "$tmp/core.out" && ! grep -q '^Details: ' "$tmp/core.out"; then
        echo "Astrid couldn't finish. Your work is kept." >&2
        echo "Details: $log" >&2
    fi
    exit "$status"
fi
